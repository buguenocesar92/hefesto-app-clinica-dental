# =============================================================================
# Hefesto Studio — ClinicaDental: interfaz
# =============================================================================
# Copie este archivo a `.env` y complete los valores.
# =============================================================================

# Direccion interna de la API de Laravel, vista desde el servidor de Nuxt.
# Esta variable NUNCA sale hacia el navegador: vive en `runtimeConfig`, no en
# `runtimeConfig.public`.
NUXT_API_BASE=http://api:8000

# Dias que muestra la agenda por omision.
NUXT_DIAS_AGENDA=1

# Puerto en el que escucha Nuxt dentro del contenedor.
NITRO_PORT=3000

# -----------------------------------------------------------------------------
# NOTAS
# -----------------------------------------------------------------------------
# - No hay ninguna clave de API ni token de sesion en este archivo, y no debe
#   agregarse. La sesion es una cookie que viaja del navegador al servidor de
#   Nuxt y de ahi a la API: por eso el navegador no tiene ningun secreto.
# - En desarrollo, `NUXT_API_BASE` debe apuntar a la API tal como se ve desde tu
#   maquina (por ejemplo `http://localhost:8000`), no al nombre del contenedor.