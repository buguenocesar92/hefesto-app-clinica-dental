# =============================================================================
# Hefesto Studio — ClinicaDental: API (Laravel)
# =============================================================================
# Copie este archivo a `.env` y complete los valores.
# NUNCA versione el `.env` con valores reales.
# =============================================================================

APP_NAME=ClinicaDental
# `local` en desarrollo, `production` en produccion.
APP_ENV=local
# En produccion tiene que ser `false`: el registro con nivel `debug` puede
# incluir datos de una peticion, y en un consultorio eso incluye el detalle de
# una intervencion sobre una pieza.
APP_DEBUG=false
APP_TIMEZONE=America/Santiago
APP_URL=http://localhost:8000

APP_KEY=
# Generelo con: php artisan key:generate

LOG_CHANNEL=stack
LOG_STACK=single,stderr
# `debug` deja el cuerpo de las peticiones en el registro. Con datos de salud,
# en produccion tiene que ser `info` o mas alto.
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
# PostgreSQL, obligatorio. La Row Level Security no existe en otro motor, y el
# aislamiento entre consultorios depende de ella. Ver docs/03.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=clinica_dental
DB_USERNAME=clinica_dental
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Rol de arranque de PostgreSQL
# ---------------------------------------------------------------------------
# El rol de arriba es el de la APLICACION. Este es el de arranque: la imagen
# oficial lo crea como superusuario, asi que la aplicacion NUNCA conecta con el.
# Con superusuario, PostgreSQL ignora las politicas de Row Level Security y una
# empresa podria ver los datos de otra. Los dos detalles, en docs/03.
DB_ADMIN_USERNAME=clinica_dental_admin
DB_ADMIN_PASSWORD=

# `prefer` sirve dentro de la red de Compose. Si la base queda afuera de la
# instalacion, use `require` y revise la cadena de conexion. Ver docs/04.
DB_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Conexion de la bitacora de accesos al historial odontologico
# -----------------------------------------------------------------------------
# Aparte a proposito: la peticion que se deniega termina revertida, y el registro
# del intento tiene que sobrevivir a esa reversa. Ver BitacoraOdontograma.
# Puede apuntar a otra base de datos, incluso a otra maquina.
DB_AUDITORIA_HOST=postgres
DB_AUDITORIA_PORT=5432
DB_AUDITORIA_DATABASE=clinica_dental
DB_AUDITORIA_USERNAME=clinica_dental
DB_AUDITORIA_PASSWORD=
DB_AUDITORIA_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Redis (cache, sesiones y colas)
# -----------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
# Minutos que dura una sesion abierta. En un consultorio conviene poco: una
# sesion abierta mucho rato es una sesion abierta al historial odontologico.
SESSION_EXPIRACION_MINUTOS=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Authentik (identidad de Hefesto)
# -----------------------------------------------------------------------------
# URL publica del emisor, SIN barra final. El descubrimiento OIDC se lee de
# `<AUTHENTIK_ISSUER>/.well-known/openid-configuration`.
AUTHENTIK_ISSUER=
# Cliente OIDC EXCLUSIVO de esta aplicacion: asi se puede revocar el acceso a
# ClinicaDental sin tocar las demas aplicaciones de Hefesto.
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Debe coincidir exactamente con la URL de retorno configurada en Authentik.
AUTHENTIK_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
AUTHENTIK_ALGORITMO=RS256
# Audiencia esperada del `id_token`. Si se deja vacia, se usa el identificador
# del cliente.
AUTHENTIK_AUDIENCE=
AUTHENTIK_LEEWAY=60
AUTHENTIK_CACHE_METADATA=60
AUTHENTIK_CACHE_JWKS=1440
# Prefijo de los equipos de Authentik que declaran el rol. Ver docs/05.
AUTHENTIK_GRUPO_POR_CONSULTORIO=ClinicaDental
AUTHENTIK_EQUIPO_RECEPCION=Recepcion de ClinicaDental
AUTHENTIK_EQUIPO_PROFESIONAL=Profesionales de ClinicaDental
AUTHENTIK_EQUIPO_ADMINISTRADOR=Administradores de ClinicaDental

# -----------------------------------------------------------------------------
# Reglas de la aplicacion
# -----------------------------------------------------------------------------
CLINICA_DENTAL_DURACION_MAXIMA_MINUTOS=240
CLINICA_DENTAL_ANTICIPACION_MAXIMA_DIAS=180
CLINICA_DENTAL_MARGEN_ENTRE_CITAS=0

# -----------------------------------------------------------------------------
# ALERGIAS
# -----------------------------------------------------------------------------
# Dias de vigencia por omision de un desbloqueo de alergia. VACIO significa que
# el desbloqueo NO VENCE: vale hasta que un profesional lo cierre a mano.
#
# No hay un valor por omision en el software, y esa es una decision: un plazo
# inventado seria un dato que nadie sabe defender. Ver docs/07.
CLINICA_DENTAL_VIGENCIA_DESBLOQUEO_DIAS=

# -----------------------------------------------------------------------------
# CONSERVACION: ESTA DECISION ES DEL CLIENTE, NO DEL SOFTWARE
# -----------------------------------------------------------------------------
# La Ley 19.628 obliga a que la conservacion tenga una finalidad declarada, pero
# no se pudo verificar en este entorno el plazo que corresponde a una ficha
# odontologica. Por eso estas variables NACEN VACIAS.
#
# Vacia significa: "no hay plazo configurado". La aplicacion NO purga nada por su
# cuenta; borrar historia clinica porque paso un numero inventado seria peor que
# no borrar nunca. Ver docs/07.
#
# COMPLETAR solo cuando el consultorio cliente, con su revisions legal, tenga un
# plazo escrito. El valor va en DIAS.
CLINICA_DENTAL_RETENCION_BITACORA_DIAS=
CLINICA_DENTAL_RETENCION_INTERVENCIONES_DIAS=
CLINICA_DENTAL_AVISAR_ANTES_DE_PURGAR=false

# -----------------------------------------------------------------------------
# Alertas
# -----------------------------------------------------------------------------
# Umbrales para revisar la bitacora. Los umbrales existen; el AVISO AUTOMATICO
# NO ESTA IMPLEMENTADO (no hay correo saliente). Ver docs/10.
CLINICA_DENTAL_ALERTA_DENEGADOS_POR_HORA=20
CLINICA_DENTAL_ALERTA_DENEGADOS_POR_USUARIO=5

# -----------------------------------------------------------------------------
# Odontograma
# -----------------------------------------------------------------------------
# Crear el mapa con sus 32 piezas al primer vistazo del paciente.
CLINICA_DENTAL_ALTA_ODONTOGRAMA_AUTOMATICA=true
# `nuevo` o `migracion`, segun como se armo la ficha.
CLINICA_DENTAL_ORIGEN_ODONTOGRAMA=nuevo