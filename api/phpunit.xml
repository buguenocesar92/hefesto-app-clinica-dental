<?xml version="1.0" encoding="UTF-8"?>
<!--
    Configuracion de PHPUnit de ClinicaDental.

    Las suites `Aislamiento` y `Permisos` estan separadas a proposito:

      - `Aislamiento`: un consultorio no puede leer los datos de otro. Usa Row
        Level Security de PostgreSQL.
      - `Permisos`: dentro del consultorio, recepcion agenda y ve el mapa, pero
        no la cronologia de las piezas; y una alergia activa bloquea la atencion
        hasta que un profesional lo firme.

    Se pueden correr solas:
        php artisan test --testsuite=Aislamiento
        php artisan test --testsuite=Permisos
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Aislamiento">
            <directory>tests/Feature/Aislamiento</directory>
        </testsuite>
        <testsuite name="Permisos">
            <directory>tests/Feature/Permisos</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!--
            IMPORTANTE: la base de pruebas TIENE que ser PostgreSQL, no SQLite.

            El aislamiento entre consultorios esta implementado con Row Level
            Security, que es una funcion de PostgreSQL. En SQLite estas pruebas
            pasarían sin comprobar nada: un sistema sin aislamiento alguno
            tambien daria verde, porque SQLite no tiene RLS que lo niegue.

            Esto ya se detecto en otro proyecto de Hefesto y se deja escrito para
            que no se repita. Ver docs/10.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="clinica_dental_test"/>
    </php>
</phpunit>